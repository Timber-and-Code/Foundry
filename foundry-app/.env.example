VITE_FOUNDRY_AI_WORKER_URL=https://your-worker-url.workers.dev
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# REQUIRED for production builds — `npm run build` fails without it. Sentry.init()
# no-ops silently when the DSN is missing, so a bundle built without it reports
# nothing at all. Public write-only key (it ships in the JS bundle); copy it from
# a deployed bundle or the Cloudflare Pages build command. Every build machine
# needs its own copy — .env is gitignored. Set ALLOW_MISSING_SENTRY_DSN=1 to
# build without telemetry anyway.
VITE_SENTRY_DSN=your_sentry_dsn
