      <PreActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Foundry — build web + cap sync"
               scriptText = "# Auto-prep web assets before every Archive.&#10;# Set up by scripts/setup-ios-archive-hook.sh — do not edit by hand.&#10;# Logs land in /tmp/foundry-archive-prep.log so Xcode&apos;s scheme log&#10;# stays readable.&#10;set -e&#10;cd &quot;$SRCROOT/../..&quot;&#10;LOG=/tmp/foundry-archive-prep.log&#10;{&#10;  echo &quot;[$(date)] foundry archive pre-action&quot;&#10;  /usr/local/bin/npm run build || /opt/homebrew/bin/npm run build || npm run build&#10;  /usr/local/bin/npx cap sync ios || /opt/homebrew/bin/npx cap sync ios || npx cap sync ios&#10;} &gt; &quot;$LOG&quot; 2&gt;&amp;1&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "504EC3031FED79650016851F"
                     BuildableName = "App.app"
                     BlueprintName = "App"
                     ReferencedContainer = "container:App.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PreActions>
   </ArchiveAction>
</Scheme>
