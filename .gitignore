# Dependencies
foundry-app/node_modules/

# Build output — GitHub Actions builds and deploys via actions/deploy-pages
foundry-app/dist/

# Native platforms
# Android is built locally and not needed in the repo.
foundry-app/android/
# iOS IS tracked so native/Xcode work syncs across machines. Build artifacts
# (Pods, DerivedData, App/App/public, xcuserdata, generated config) are
# excluded by the Capacitor-generated foundry-app/ios/.gitignore.

# Environment files
foundry-app/.env

# IDE
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Large image files at root
*.png
# Allow all shipped public assets (PWA icons + onboarding imagery, etc.)
!foundry-app/public/*.png
# App icon + splash assets are real iOS source, not stray screenshots
!foundry-app/ios/**/*.png

# Old anchor icon option files
anchor_icon_options*.html
